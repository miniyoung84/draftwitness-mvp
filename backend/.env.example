# Copy to .env and adjust for your environment.
# Django
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave DATABASE_URL empty to use local SQLite (db.sqlite3).
# For PostgreSQL, set all of the following:
DATABASE_URL=
POSTGRES_DB=draftwitness
POSTGRES_USER=draftwitness
POSTGRES_PASSWORD=draftwitness
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# CORS: comma-separated origins allowed to call the API (the Next.js dev server).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
